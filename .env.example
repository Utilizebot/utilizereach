# ===========================================
# UTILIZEREACH - DOCKER COMPOSE ENVIRONMENT
# ===========================================
# Copy this file to .env and adjust as needed.
# ALL values are optional - `docker compose up -d` works with the defaults
# and the Setup Wizard (http://localhost:3000) configures the API keys.

# ===========================================
# POSTGRES (application database)
# ===========================================
# Change the password for production deployments.
POSTGRES_USER=marketing
POSTGRES_PASSWORD=marketing
POSTGRES_DB=marketing_ai
# Host port for the Postgres container (bound to 127.0.0.1 only)
POSTGRES_HOST_PORT=5432

# ===========================================
# AUTH
# ===========================================
# HS256 secret for JWT auth tokens. If left empty, the backend generates
# one during the Setup Wizard and stores it in the backend config volume.
JWT_SECRET=

# ===========================================
# MULTI-BRAND ISOLATION (recommended for production)
# ===========================================
# Set to enable the least-privilege app role + row-level security: the
# backend, Celery worker and beat then connect as the non-owner role app_rw,
# so Postgres itself keeps each brand's rows separate. Migrations keep using
# the POSTGRES_USER owner. Generate with: openssl rand -hex 24
APP_DB_PASSWORD=
# Emergency switch: set to "off" to make the app connect as the owner again
# (app-level brand scoping still applies, row-level security does not).
TENANCY_APP_ROLE=on

# ===========================================
# HOST PORTS
# ===========================================
BACKEND_PORT=8000
FRONTEND_PORT=3000
HTTP_PORT=80
HTTP_ALT_PORT=8080
# Redis host port (bound to 127.0.0.1 only)
REDIS_HOST_PORT=6379

# ===========================================
# API KEYS (also configurable via the Setup Wizard)
# ===========================================
GEMINI_API_KEY=
GOOGLE_API_KEY=
SERPAPI_KEY=

# Google OAuth (optional - for Gmail sending)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===========================================
# FRONTEND BUILD ARGS
# ===========================================
# Leave empty to use relative URLs via the nginx proxy (recommended).
VITE_API_URL=
