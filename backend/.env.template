# Marketing AI - Backend Environment Template
# This file allows Docker to start without configuration
# The Setup Wizard will generate the real .env file
# DO NOT add real credentials here - use the Setup Wizard instead

# Placeholder values (will be configured via Setup Wizard)
GOOGLE_API_KEY=

# Redis (default Docker internal network)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Application settings
ENVIRONMENT=production
DEBUG=false
API_PORT=8000
