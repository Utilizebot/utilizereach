# ============================================
# UTILIZEREACH - BACKEND ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your values
# ============================================

# ===========================================
# DATABASE (Required)
# ===========================================
# Docker: set automatically by docker-compose (postgres service)
# Local dev: point at your local Postgres instance
DATABASE_URL=postgresql://marketing:marketing@localhost:5432/marketing_ai
# Alternatively use the individual variables instead of DATABASE_URL:
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=marketing
# POSTGRES_PASSWORD=marketing
# POSTGRES_DB=marketing_ai

# ===========================================
# AUTH (Required)
# ===========================================
# HS256 secret for JWT auth tokens - use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
# Token lifetime in days (default 7)
JWT_EXPIRES_DAYS=7

# ===========================================
# REDIS CONFIGURATION (Required for Celery)
# ===========================================
# Docker: redis://redis:6379/0
# Local: redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0

# ===========================================
# CELERY CONFIGURATION (Required for background tasks)
# ===========================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ===========================================
# APPLICATION SETTINGS
# ===========================================
ENVIRONMENT=production
DEBUG=false
API_PORT=8000
CSV_STORAGE_PATH=/app/storage/csv_files

# ===========================================
# CORS ORIGINS (Required for frontend access)
# ===========================================
# Comma-separated list of allowed origins
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ===========================================
# BACKEND URL (Required for email tracking)
# ===========================================
# Used for tracking pixels in emails
BACKEND_URL=https://your-domain.com

# ===========================================
# GOOGLE GEMINI AI (Required for AI emails)
# ===========================================
# Get from: https://aistudio.google.com/apikey
# Both names provided for compatibility
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_API_KEY=your-gemini-api-key

# ===========================================
# ZHIPUAI GLM (Optional - used by chatbot features)
# ===========================================
# Get from: https://open.bigmodel.cn/
GLM_API_KEY=your-glm-api-key

# ===========================================
# SERPAPI (Optional - for lead scraping)
# ===========================================
# Get from: https://serpapi.com
SERPAPI_KEY=your-serpapi-key

# ===========================================
# GOOGLE OAUTH (Required for Gmail sending)
# ===========================================
# Get from: Google Cloud Console > APIs & Services > Credentials
# Add redirect URI: http://YOUR_SERVER:8000/api/email-accounts/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===========================================
# FRONTEND URL (Required for OAuth redirects)
# ===========================================
# URL where your frontend is hosted
FRONTEND_URL=http://localhost:3000

# ===========================================
# TEAM CONFIG FILE (Optional)
# ===========================================
# Path to custom team config JSON file
# Default: backend/config/team_config.json
# TEAM_CONFIG_FILE=/path/to/team_config.json
